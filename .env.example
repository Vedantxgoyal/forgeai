# Copy to .env. Every setting is optional.

# --- Option A: local Ollama (default; slow on CPU-only machines) ----------
FORGE_LLM_BASE_URL=http://localhost:11434/v1
FORGE_LLM_API_KEY=ollama
FORGE_GEN_MODEL=llama3.2:3b
FORGE_JUDGE_MODEL=llama3.2:3b
FORGE_AGENT_MODEL=llama3.2:3b

# --- Option B: Groq free tier (hosted open models; minutes per run) -------
# Check model names at https://console.groq.com/docs/models before using.
# FORGE_LLM_BASE_URL=https://api.groq.com/openai/v1
# FORGE_LLM_API_KEY=gsk_your_key_here
# FORGE_GEN_MODEL=llama-3.1-8b-instant
# FORGE_AGENT_MODEL=llama-3.1-8b-instant
# FORGE_JUDGE_MODEL=<a different family, e.g. a Qwen or Gemma model listed on Groq>

FORGE_EMBED_BACKEND=auto
